{
  "name": "@markpost/cli",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "bin": {
    "markpost": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "watch": "tsc --watch & tsc-alias --watch",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "npm run test -- --ui",
    "lint": "prettier --check ./src && eslint ./src",
    "lint:fix": "prettier --write ./src && eslint --fix ./src",
    "prepare": "husky",
    "sync:contract": "node scripts/sync-contract.mjs",
    "sync:markdown-serialization": "node scripts/sync-markdown-serialization.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@sindresorhus/slugify": "^3.0.0",
    "chalk": "^6.0.0",
    "cli-spinners": "^3.4.0",
    "conf": "^15.1.0",
    "yocto-spinner": "^1.2.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "nanoid@^3": "^3.3.17"
  }
}
