{
  "name": "@markpost/cli",
  "version": "0.1.0-alpha.0",
  "description": "",
  "license": "UNLICENSED",
  "keywords": [
    "markdown",
    "sync",
    "cli",
    "obsidian",
    "notes",
    "webhooks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neonpixels-studio/markpost-cli.git"
  },
  "homepage": "https://github.com/neonpixels-studio/markpost-cli#readme",
  "bugs": {
    "url": "https://github.com/neonpixels-studio/markpost-cli/issues"
  },
  "type": "module",
  "bin": {
    "markpost": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#src/*": {
      "types": "./src/*",
      "default": "./dist/*"
    }
  },
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "watch": "tsc --watch",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "npm run test -- --ui",
    "lint": "prettier --check ./src && eslint ./src",
    "lint:fix": "prettier --write ./src && eslint --fix ./src",
    "prepare": "husky",
    "prepublishOnly": "npm run lint && npm run test:ci",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "postpack": "node -e \"require('node:fs').accessSync('dist/index.js')\"",
    "release:alpha": "npm version prerelease --preid alpha --no-git-tag-version",
    "sync:contract": "node scripts/sync-contract.mjs",
    "sync:markdown-serialization": "node scripts/sync-markdown-serialization.mjs",
    "sync:source-endpoints": "node scripts/sync-source-endpoints.mjs",
    "sync:source-contract": "node scripts/sync-source-contract.mjs",
    "sync:settings-contract": "node scripts/sync-settings-contract.mjs",
    "sync:scopes-contract": "node scripts/sync-scopes-contract.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@sindresorhus/slugify": "^4.0.0",
    "chalk": "^6.0.1",
    "cli-spinners": "^3.4.0",
    "conf": "^16.0.0",
    "env-paths": "^4.0.0",
    "yocto-spinner": "^1.2.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "fast-uri": "^3.1.8",
    "nanoid@^3": "^3.3.17"
  }
}
