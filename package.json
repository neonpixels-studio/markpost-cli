{
  "name": "@markpost/cli",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "bin": {
    "markpost": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#src/*": {
      "types": "./src/*",
      "default": "./dist/*"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "watch": "tsc --watch",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "npm run test -- --ui",
    "lint": "prettier --check ./src && eslint ./src",
    "lint:fix": "prettier --write ./src && eslint --fix ./src",
    "prepare": "husky",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "postpack": "node -e \"require('node:fs').accessSync('dist/index.js')\"",
    "sync:contract": "node scripts/sync-contract.mjs",
    "sync:markdown-serialization": "node scripts/sync-markdown-serialization.mjs",
    "sync:source-endpoints": "node scripts/sync-source-endpoints.mjs",
    "sync:source-contract": "node scripts/sync-source-contract.mjs",
    "sync:settings-contract": "node scripts/sync-settings-contract.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@sindresorhus/slugify": "^3.0.1",
    "chalk": "^6.0.1",
    "cli-spinners": "^3.4.0",
    "conf": "^15.1.0",
    "yocto-spinner": "^1.2.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "fast-uri": "^3.1.8",
    "nanoid@^3": "^3.3.17"
  }
}
